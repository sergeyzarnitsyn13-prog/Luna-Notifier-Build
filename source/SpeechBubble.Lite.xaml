<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="420" MaxWidth="420" SizeToContent="Height" Opacity="1" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True">
 <Window.Resources>
  <!-- Original approved MoonGlow v10 surface — unchanged. -->
  <LinearGradientBrush x:Key="MoonWhiteSurface" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#FFFFFF" Offset="0"/>
   <GradientStop Color="#FCFEFF" Offset="0.30"/>
   <GradientStop Color="#F3F9FF" Offset="0.72"/>
   <GradientStop Color="#DDEFFF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="MoonActionSurface" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#EEF7FF" Offset="0"/>
   <GradientStop Color="#D8EAFF" Offset="0.55"/>
   <GradientStop Color="#BDD9FF" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="QuietAction" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#1B64B5"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Action" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Action" Property="Background" Value="#EEF7FF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Action" Property="Background" Value="#EAF5FF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Action" Property="Opacity" Value="0.72"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="BubbleRoot" Margin="16" Opacity="0" ClipToBounds="False">
  <Grid.CacheMode><BitmapCache/></Grid.CacheMode>
  <Grid.RenderTransform><ScaleTransform ScaleX="0.08" ScaleY="0.08"/></Grid.RenderTransform>
  <!-- Original MoonGlow v10 shadow, halo, rim and opaque body. Only the tail geometry is removed. -->
  <Canvas IsHitTestVisible="False" ClipToBounds="False">
   <Path Data="{Binding Data, ElementName=BubbleOutline}" Fill="#F4FAFF" IsHitTestVisible="False">
    <Path.Effect><DropShadowEffect Color="#305A82" BlurRadius="18" ShadowDepth="4" Opacity="0.14"/></Path.Effect>
   </Path>
   <Path Data="{Binding Data, ElementName=BubbleOutline}" Stroke="#87D6FF" StrokeThickness="2.40" IsHitTestVisible="False">
    <Path.Effect><DropShadowEffect Color="#56CAFF" BlurRadius="29" ShadowDepth="0" Opacity="0.92"/></Path.Effect>
   </Path>
   <Path Data="{Binding Data, ElementName=BubbleOutline}" Stroke="#C8F4FF" StrokeThickness="0.98" IsHitTestVisible="False" Opacity="0.94"/>
   <Path x:Name="BubbleOutline" Fill="{StaticResource MoonWhiteSurface}" Stroke="#D9F2FF" StrokeThickness="0.78" IsHitTestVisible="False"/>
  </Canvas>
  <!-- Reduced from the v10 chat-specific action row: notification retains original typography. -->
  <Grid Margin="18,13,18,15">
   <Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <TextBlock Text="Luna" FontSize="16" FontWeight="SemiBold" Foreground="#123E74" VerticalAlignment="Center"/>
    <Button x:Name="DismissButton" Width="22" Height="22" Padding="6" HorizontalAlignment="Right" Style="{StaticResource QuietAction}" ToolTip="Закрыть" AutomationProperties.Name="Закрыть реплику">
     <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="#748EAE" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
    </Button>
   </Grid>
   <TextBlock x:Name="TaskText" Grid.Row="1" Margin="0,5,0,0" TextWrapping="Wrap" TextTrimming="None" FontFamily="Segoe UI" FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight" Foreground="#214162"/>
  </Grid>
 </Grid>
</Window>
