<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="420" MaxWidth="420" SizeToContent="Height" Opacity="1" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True">
 <Window.Resources>
  <!-- Approved Moon Glow surface: almost white, only a very light icy-blue falloff. -->
  <LinearGradientBrush x:Key="MoonWhiteSurface" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#FFFFFF" Offset="0"/>
   <GradientStop Color="#FCFEFF" Offset="0.30"/>
   <GradientStop Color="#F3F9FF" Offset="0.72"/>
   <GradientStop Color="#DDEFFF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="MoonActionSurface" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#EEF7FF" Offset="0"/>
   <GradientStop Color="#D8EAFF" Offset="0.55"/>
   <GradientStop Color="#BDD9FF" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="QuietAction" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#1B64B5"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Action" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Action" Property="Background" Value="#EEF7FF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Action" Property="Background" Value="#EAF5FF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Action" Property="Opacity" Value="0.72"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>

 <Grid x:Name="MoonScene" Margin="16" ClipToBounds="False">
  <!-- The atmospheric bloom appears first, before the card takes shape. -->
  <Ellipse x:Name="AmbientGlow" Fill="#8DD6FF" Opacity="0" Margin="13,5" IsHitTestVisible="False">
   <Ellipse.Effect><BlurEffect Radius="30" RenderingBias="Performance"/></Ellipse.Effect>
  </Ellipse>
  <Grid x:Name="BubbleRoot" Opacity="0" ClipToBounds="False" RenderTransformOrigin="0.70,0.75">
   <Grid.CacheMode><BitmapCache/></Grid.CacheMode>
   <Grid.RenderTransform><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Grid.RenderTransform>
   <!-- The shape has no disconnected tail: this version does not use a tray anchor. -->
   <Canvas IsHitTestVisible="False" ClipToBounds="False">
    <Path Data="{Binding Data, ElementName=BubbleOutline}" Fill="#F4FAFF" IsHitTestVisible="False">
     <Path.Effect><DropShadowEffect Color="#305A82" BlurRadius="18" ShadowDepth="3" Opacity="0.14"/></Path.Effect>
    </Path>
    <Path x:Name="MoonHalo" Data="{Binding Data, ElementName=BubbleOutline}" Stroke="#8BDFFF" StrokeThickness="1.75" Opacity="0.70" IsHitTestVisible="False">
     <Path.Effect><DropShadowEffect Color="#56C7FF" BlurRadius="26" ShadowDepth="0" Opacity="0.72"/></Path.Effect>
    </Path>
    <Path Data="{Binding Data, ElementName=BubbleOutline}" Stroke="#D9F6FF" StrokeThickness="0.85" Opacity="0.85" IsHitTestVisible="False"/>
    <Path x:Name="BubbleOutline" Fill="{StaticResource MoonWhiteSurface}" Stroke="#CFEFFF" StrokeThickness="0.88" IsHitTestVisible="False"/>
   </Canvas>
   <Grid Margin="18,14,18,16">
    <Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <TextBlock x:Name="TitleText" Text="Luna" Opacity="0" FontSize="16" FontWeight="SemiBold" Foreground="#123E74" VerticalAlignment="Center"/>
     <Button x:Name="DismissButton" Opacity="0" Width="22" Height="22" Padding="6" HorizontalAlignment="Right" Style="{StaticResource QuietAction}" ToolTip="Закрыть" AutomationProperties.Name="Закрыть реплику">
      <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="#748EAE" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
     </Button>
    </Grid>
    <TextBlock x:Name="TaskText" Grid.Row="1" Opacity="0" Margin="0,5,0,0" TextWrapping="Wrap" TextTrimming="None" FontFamily="Segoe UI" FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight" Foreground="#214162"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
